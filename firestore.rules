rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 아래 두 이메일로 로그인한 사람만 읽고 쓸 수 있습니다. (두 분의 실제 이메일로 바꿔 주세요)
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          '남편이메일@gmail.com',
          '와이프이메일@gmail.com'
        ];
    }
  }
}
